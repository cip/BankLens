#!/bin/sh
set -eu
project_dir=$(CDPATH= cd -- "$(dirname -- "$0")/.." && pwd)
cd "$project_dir"
if [ -n "${BANKLENS_PYTHON:-}" ]; then
    exec "$BANKLENS_PYTHON" -m banklens_pdf "$@"
fi
project_python="$project_dir/.venv/bin/python3"
if [ -x "$project_python" ]; then
    exec "$project_python" -m banklens_pdf "$@"
fi
exec python3 -m banklens_pdf "$@"
